# Copy this file to .env for local development (uvicorn loads it automatically
# if you run `pip install python-dotenv`, which is already in requirements.txt —
# but you still need a small one-line loader; see README "Desarrollo local").
# In Vercel, set these as Project Settings → Environment Variables instead.

# --- Base de datos ---
# Local rápido sin instalar nada: deja esta línea comentada y se usará SQLite.
# DATABASE_URL=sqlite:///./habit_tracker.db
#
# Supabase (producción / Vercel): usa la cadena de "Connection pooling"
# (Session/Transaction pooler, puerto 6543), NO la conexión directa (5432),
# porque las funciones serverless abren/cierran conexiones constantemente.
# La encuentras en Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dkjfghsukjuhy8q74yriquahfdq78e
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# --- CORS ---
# En local puedes dejarlo en "*". En producción, pon el dominio exacto de tu
# frontend en Vercel, por ejemplo: https://rutina-app.vercel.app
ALLOWED_ORIGINS=*

# --- Email (recuperación de contraseña) ---
# Gmail: activa "Contraseñas de aplicación" en tu cuenta Google y usa esa clave aquí.
# (Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=tu@gmail.com
# URL pública de tu frontend (sin barra al final)
APP_URL=http://localhost:5173
